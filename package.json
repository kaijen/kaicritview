{
  "name": "kaicritview",
  "displayName": "CriticMarkup Preview",
  "description": "Renders CriticMarkup in VSCode's built-in Markdown preview.",
  "version": "0.1.0",
  "publisher": "kaijen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaijen/kaicritview.git"
  },
  "bugs": {
    "url": "https://github.com/kaijen/kaicritview/issues"
  },
  "homepage": "https://github.com/kaijen/kaicritview#readme",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "criticmarkup",
    "preview"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./critic.css"
    ]
  }
}
